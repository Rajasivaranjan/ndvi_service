# Application Settings
APP_NAME=NDVI Service
APP_VERSION=1.0.0
DEBUG=false

# Google Earth Engine Settings
# Set your Google Cloud Project ID (required for Earth Engine)
GEE_PROJECT=your-project-id

# Optional: Use service account for production deployments
# Uncomment and configure these if using a service account:
# GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
# GEE_CREDENTIALS_PATH=/path/to/service-account-key.json

# API Settings
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]
